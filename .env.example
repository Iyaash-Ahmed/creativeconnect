# Copy this file to ".env" and fill in real values. Never commit ".env".

# Port the server listens on (Render/Railway set this automatically).
PORT=3000

# Set to "production" when deploying (enables secure cookies + caching).
NODE_ENV=development

# Secret used to sign admin login tokens. Use a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string

# First admin account, created automatically on first run.
# If you leave ADMIN_PASSWORD blank, a strong one is generated and printed once.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-something-strong

# Optional: custom SQLite file location (defaults to ./data/creativeconnect.db)
# DB_PATH=./data/creativeconnect.db

# --- Email notifications (optional) ---------------------------------------
# When these are set, the business is emailed on every new booking request.
# Example for Gmail: create an App Password and use it as SMTP_PASS.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=you@example.com
# SMTP_PASS=your-app-password
# MAIL_FROM=CreativeConnect <you@example.com>
# MAIL_TO=where-leads-should-go@example.com   # defaults to the contact email in Settings
